{
  "_doc": "SSSF-48 one-way-door patterns, read by scripts/one_way_door.py. A PR is one-way if any changed path (both sides of a rename, deleted files too) matches a path pattern, or any ADDED diff line in a non-exempt file matches a content pattern. The PR body cannot downgrade this: it is agent-written. Globs: ** = any number of directories, * = within one segment. repos (optional) limits a pattern to those repos. Each entry was grounded in a real file before it was added (the record is in SSSF-48); test_path and fixture are made up and exist only so the tests can prove each entry fires. Design: docs/specs/2026-11-21-one-way-door-lane.md.",
  "version": 1,
  "content_exempt_paths": [
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/fixtures/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.py",
    "**/*.md",
    "**/docs/**"
  ],
  "path_patterns": [
    {
      "id": "sql-migration",
      "kind": "migration",
      "blast": "repo",
      "globs": [
        "**/migrations/**",
        "**/*.sql",
        "**/run-migrations.*"
      ],
      "exclude": [
        "**/tests/**",
        "**/test/**",
        "**/fixtures/**"
      ],
      "why": "A migration changes a live database's shape; rolling the code back does not roll the data back.",
      "test_path": "db/migrations/001_example.sql"
    },
    {
      "id": "one-off-migration-script",
      "kind": "migration",
      "blast": "repo",
      "globs": [
        "migration/**",
        "scripts/migrate-*",
        "scripts/**/migrate.*"
      ],
      "exclude": [
        "**/*.test.*"
      ],
      "repos": [
        "BJGLLC/bjg-intranet"
      ],
      "why": "One-off backfill and migration scripts rewrite a data store in place.",
      "test_path": "scripts/migrate-example.ts"
    },
    {
      "id": "drop-script",
      "kind": "delete",
      "blast": "repo",
      "globs": [
        "**/drop-*.ts",
        "**/drop-*.mjs",
        "**/drop-*.py"
      ],
      "exclude": [
        "**/*.test.*",
        "**/tests/**",
        "**/test/**"
      ],
      "why": "Scripts named drop-* delete stored data; there is no undo short of a restore.",
      "test_path": "scripts/drop-example-tables.ts"
    },
    {
      "id": "n8n-live-workflows",
      "kind": "send",
      "blast": "customer",
      "globs": [
        "n8n/workflows/**"
      ],
      "repos": [
        "BJGLLC/cd-lead-agent-deploy"
      ],
      "why": "Deployed workflow definitions that can message customers.",
      "test_path": "n8n/workflows/example.json"
    },
    {
      "id": "bot-prompts-and-templates",
      "kind": "send",
      "blast": "customer",
      "globs": [
        "config/assets/prompts/**",
        "config/assets/templates/**"
      ],
      "repos": [
        "BJGLLC/cd-lead-agent-deploy"
      ],
      "why": "Prompts and templates whose words reach customers.",
      "test_path": "config/assets/prompts/example.md"
    },
    {
      "id": "runtime-job-flags",
      "kind": "send",
      "blast": "customer",
      "globs": [
        "config/eos-runtime-flags.json"
      ],
      "repos": [
        "BJGLLC/cd-lead-agent-deploy"
      ],
      "why": "Runtime flags and timers decide which jobs run and when, including jobs that message customers.",
      "test_path": "config/eos-runtime-flags.json"
    },
    {
      "id": "marketing-flow-workflows",
      "kind": "send",
      "blast": "customer",
      "globs": [
        "**/*.workflow.js",
        "**/*.workflow.json",
        "**/_assets/templates/dist/**"
      ],
      "repos": [
        "BJGLLC/cd-marketing"
      ],
      "why": "Workflow definitions and built email templates that reach customers.",
      "test_path": "flows/example.workflow.js"
    },
    {
      "id": "social-publish",
      "kind": "send",
      "blast": "customer",
      "globs": [
        "scripts/install-cron.sh",
        "scripts/run-publish.sh"
      ],
      "repos": [
        "BJGLLC/content-engine"
      ],
      "why": "The scripts that schedule and run public posting.",
      "test_path": "scripts/run-publish.sh"
    },
    {
      "id": "ad-platform-writers",
      "kind": "money",
      "blast": "money",
      "globs": [
        "claude-ops/scripts/meta_build_*.py",
        "claude-ops/scripts/meta_ads_client.py",
        "claude-ops/scripts/meta_stage_*.py"
      ],
      "repos": [
        "BJGLLC/cd-marketing"
      ],
      "why": "Scripts that create and edit ad campaigns and budgets: real spend.",
      "test_path": "claude-ops/scripts/meta_build_example.py"
    },
    {
      "id": "secret-bearing-files",
      "kind": "secret",
      "blast": "repo",
      "globs": [
        "**/.env",
        "**/.env.*",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/gitleaks.toml",
        "**/.gitleaks.toml"
      ],
      "exclude": [
        "**/*.example",
        "**/tests/**",
        "**/test/**",
        "**/docs/**"
      ],
      "why": "Files that hold secret values, or the leak scanner's allowlist: a secret pushed to GitHub is out for good and must be rotated.",
      "test_path": "app/.env"
    }
  ],
  "content_patterns": [
    {
      "id": "ghl-send-endpoint",
      "kind": "send",
      "blast": "customer",
      "regex": "/conversations/messages[\"'`]",
      "why": "The send-message call. Reads of one message use /conversations/messages/{id} and do not match.",
      "test_path": "src/example_module.py",
      "fixture": "        GHL_BASE + \"/conversations/messages\","
    },
    {
      "id": "ghl-message-type",
      "kind": "send",
      "blast": "customer",
      "regex": "[\"']type[\"']\\s*:\\s*[\"'](SMS|Email|WhatsApp)[\"']",
      "why": "A message payload names its channel; a new one is a new customer send.",
      "test_path": "src/example_module.py",
      "fixture": "                        \"type\": \"Email\","
    },
    {
      "id": "social-post-call",
      "kind": "send",
      "blast": "customer",
      "regex": "/(media_publish|photos|feed)[`'\"?]|\\$\\{REST\\}/posts[`'\"]|/rest/posts[`'\"]",
      "repos": [
        "BJGLLC/content-engine"
      ],
      "why": "API calls that put a post on a public page.",
      "test_path": "src/example_module.py",
      "fixture": "  const res = await fetchFn(`${GRAPH}/${version}/${pageId}/photos`, {"
    },
    {
      "id": "jobber-mutation",
      "kind": "crm-write",
      "blast": "customer",
      "regex": "\\bmutation\\s+[A-Z]\\w*\\s*[({]",
      "why": "A named GraphQL mutation writes to a customer system of record.",
      "test_path": "src/example_module.py",
      "fixture": "mutation ExampleCreate($input: ExampleInput!) {"
    },
    {
      "id": "ad-budget-field",
      "kind": "money",
      "blast": "money",
      "regex": "[\"']?\\b(daily_budget|lifetime_budget|bid_amount)\\b[\"']?\\s*[:=]",
      "why": "Setting a budget or bid on an ad object spends money. Reads (fields=...daily_budget) do not match.",
      "test_path": "src/example_module.py",
      "fixture": "            \"daily_budget\": 2500,"
    },
    {
      "id": "schema-change-sql",
      "kind": "migration",
      "blast": "repo",
      "regex": "\\bALTER\\s+TABLE\\b",
      "why": "An inline schema migration, wherever it lives.",
      "test_path": "src/example_module.py",
      "fixture": "        con.execute(\"ALTER TABLE example_receipts ADD COLUMN example_id TEXT\")"
    },
    {
      "id": "destructive-sql",
      "kind": "delete",
      "blast": "repo",
      "regex": "\\b(DROP\\s+(TABLE|COLUMN|SCHEMA|DATABASE|VIEW)|TRUNCATE(\\s+TABLE)?\\s+[\\w\"`]+)",
      "why": "Dropping or truncating loses data on the live store.",
      "test_path": "src/example_module.py",
      "fixture": "  db.exec(\"DROP TABLE example_legacy\");"
    },
    {
      "id": "unscoped-delete-sql",
      "kind": "delete",
      "blast": "repo",
      "regex": "\\bDELETE\\s+FROM\\s+[\\w.\"`]+\\s*(;|[\"'`)]|$)",
      "why": "DELETE FROM with no WHERE on the same line empties a table. Keyed deletes do not match.",
      "test_path": "src/example_module.py",
      "fixture": "    db.execute(\"DELETE FROM example_decisions\")"
    }
  ]
}
